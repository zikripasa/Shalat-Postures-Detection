# ---- Python package / scripts (all optional; defaults come from configs/default.yaml)
# Path to Salat-Postures-Dataset-main.zip (scripts/extract_dataset.py extracts it safely)
SALAT_DATASET_ZIP=
# Use an already-extracted dataset folder instead of data/raw/Salat-Postures-Dataset-main
SALAT_DATASET_DIR=
SALAT_MODELS_DIR=
SALAT_ARTIFACTS_DIR=
SALAT_SEED=42
# Frames analysed per second of video and the "uncertain" threshold
SALAT_SAMPLE_FPS=5
SALAT_UNCERTAINTY_THRESHOLD=0.55

# ---- API (backend/app/settings.py, prefix SALAT_API_)
SALAT_API_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SALAT_API_MAX_IMAGE_MB=10
SALAT_API_MAX_VIDEO_MB=150
SALAT_API_JOB_TTL_MINUTES=30
SALAT_API_MAX_CONCURRENT_JOBS=2
# SALAT_API_MODEL_DIR=models/salat_vision_v1

# ---- Frontend (frontend/.env.local)
VITE_API_BASE_URL=http://localhost:8000
